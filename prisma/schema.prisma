generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              String       @id @default(uuid())
  matricula       String       @unique
  senha           String
  nome            String
  cnh             String?
  equipe          String?
  role            Role         @default(GCM)
  status          StatusGcm    @default(ATIVO)
  totalGecpMes    Int          @default(0)
  ultimoExtra     DateTime?
  observacoes     String?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  especializacoes String?
  idEventoAtual   String?
  telefone        String?
  convocacoes     Convocacao[]
  inscricoesPush  PushSubscription[]
  eventosParaValidar Evento[]      @relation("EventoValidadores")
  checkinsValidados  Convocacao[]  @relation("ConvocacaoValidador")
}

model Evento {
  id                    String       @id @default(uuid())
  codigo                String       @unique
  dataServico           DateTime
  horario               String
  local                 String
  tipoConvocacao        String       @default("NECESSIDADE OPERACIONAL DO SERVIÇO")
  vagas                 Int
  equipePrioritaria     String
  sequenciaEscalonamento String[]    @default([])
  slaMinutos            Int?
  observacoes           String?
  criadoEm              DateTime     @default(now())
  convocacoes           Convocacao[]
  validadores           Usuario[]    @relation("EventoValidadores")
}

model Convocacao {
  id            String           @id @default(uuid())
  status        StatusConvocacao @default(PENDENTE)
  dataResposta  DateTime?
  dataLimiteSla DateTime?
  validadoPorId String?
  validadoEm    DateTime?
  eventoId      String
  gcmId         String
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt
  evento        Evento           @relation(fields: [eventoId], references: [id])
  gcm           Usuario          @relation(fields: [gcmId], references: [id])
  validadoPor   Usuario?         @relation("ConvocacaoValidador", fields: [validadoPorId], references: [id])

  @@unique([eventoId, gcmId])
}

model Equipe {
  id   String @id @default(uuid())
  nome String @unique
  cor  String
}

model EscalaOrdinaria {
  id     String   @id @default(uuid())
  data   DateTime @unique
  equipe String
}

model Notificacao {
  id        String   @id @default(cuid())
  titulo    String
  mensagem  String
  tipo      String   @default("INFO")
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  GCM
  COMANDO
  LIDER
  SUPERVISOR
}

enum StatusGcm {
  ATIVO
  INATIVO
}

enum StatusConvocacao {
  PENDENTE
  ACEITO
  RECUSADO
  CONFIRMADO
  PRESENTE
  AUSENTE
  EXPIRADO
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())
}