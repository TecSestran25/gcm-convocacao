generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              String       @id @default(uuid())
  matricula       String       @unique
  senha           String
  nome            String
  cnh             String?
  equipe          String?
  role            Role         @default(GCM)
  status          StatusGcm    @default(ATIVO)
  totalGecpMes    Int          @default(0)
  ultimoExtra     DateTime?
  observacoes     String?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt
  especializacoes String?
  idEventoAtual   String?
  telefone        String?
  convocacoes     Convocacao[]
}

model Evento {
  id                String       @id @default(uuid())
  codigo            String       @unique
  dataServico       DateTime
  horario           String
  local             String
  tipoConvocacao    String       @default("NECESSIDADE OPERACIONAL DO SERVIÇO")
  vagas             Int
  equipePrioritaria String
  observacoes       String?
  criadoEm          DateTime     @default(now())
  convocacoes       Convocacao[]
}

model Convocacao {
  id           String           @id @default(uuid())
  status       StatusConvocacao @default(PENDENTE)
  dataResposta DateTime?
  eventoId     String
  gcmId        String
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt
  evento       Evento           @relation(fields: [eventoId], references: [id])
  gcm          Usuario          @relation(fields: [gcmId], references: [id])

  @@unique([eventoId, gcmId])
}

model Notificacao {
  id        String   @id @default(cuid())
  titulo    String
  mensagem  String
  tipo      String   @default("INFO")
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  GCM
  COMANDO
  LIDER
  SUPERVISOR
}

enum StatusGcm {
  ATIVO
  INATIVO
}

enum StatusConvocacao {
  PENDENTE
  ACEITO
  RECUSADO
  CONFIRMADO
  AUSENTE
}
